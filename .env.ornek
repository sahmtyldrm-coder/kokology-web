# Kokology — ortam değişkenleri
# Bu dosyayı `.env.local` adıyla kopyalayıp değerleri doldur.
# `.env.local` git'e girmez; Vercel'de aynı değişkenler proje ayarlarından tanımlanır.

# Supabase — yönetim paneli ve site içeriği
# Proje: kokology (eu-central-1). Değerler Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NOT: Google Analytics, GTM, Meta Pixel ve Google Ads kimlikleri BURADA DEĞİL.
# Onlar yönetim panelinden giriliyor (/yonetim/iletisim → Ölçüm kodları) ve
# yalnızca ziyaretçi çerez onayı verdikten sonra yükleniyor.

# Google Search Console doğrulama kodu.
# Search Console → Mülk ekle → HTML etiketi yöntemi → content="..." içindeki değer.
# Sadece o değeri yaz, etiketin tamamını değil.
NEXT_PUBLIC_GSC_VERIFICATION=
