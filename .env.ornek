# Kokology — ortam değişkenleri
# Bu dosyayı `.env.local` adıyla kopyalayıp değerleri doldur.
# `.env.local` git'e girmez; Vercel'de aynı değişkenler proje ayarlarından tanımlanır.

# Google Analytics 4 ölçüm kimliği. Analytics → Yönetici → Veri akışları.
# Boş bırakılırsa hiçbir analytics etiketi basılmaz.
NEXT_PUBLIC_GA_ID=

# Google Search Console doğrulama kodu.
# Search Console → Mülk ekle → HTML etiketi yöntemi → content="..." içindeki değer.
# Sadece o değeri yaz, etiketin tamamını değil.
NEXT_PUBLIC_GSC_VERIFICATION=
